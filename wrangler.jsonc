{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evidenceplot-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
